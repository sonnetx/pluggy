{
  "model": {
    "name": "qwen3_dense",
    "init_from_hf": "Qwen/Qwen3-0.6B",
    "config": {
      "num_layers": 28,
      "num_heads": 16,
      "num_kv_heads": 8,
      "emb_dim": 1024,
      "head_dim": 128,
      "vocab_size": 151936,
      "ffn_dim": 3072
    }
  },
  "mesh": {
    "dp": 1
  },
  "optimizer": {
    "name": "adamw",
    "config": {
      "lr": 5e-5,
      "weight_decay": 0.1,
      "betas": [0.9, 0.95],
      "fused": true
    },
    "max_norm": 1.0,
    "scheduler": {
      "type": "wsd",
      "warmup_ratio": 0.01,
      "decay_ratio": 0.2,
      "total_steps": 500
    }
  },
  "objective": {
    "name": "AR",
    "config": {
      "ignore_index": -100,
      "fused_linear_ce": true,
      "ce_chunk_size": 4096
    }
  },
  "data": {
    "sources": [
      {"data_files": "data/synth_v0/shard-*.jsonl", "weight": 30},
      {"name": "OptimalScale/ClimbMix", "weight": 70}
    ],
    "mixing": {
      "stopping_strategy": "all_exhausted"
    },
    "split": "train",
    "tokenizer": "Qwen/Qwen3-0.6B",
    "eos_token": "<|endoftext|>",
    "pad_token": "<|fim_pad|>",
    "text_field": "text",
    "shuffle_buffer": 1000,
    "seed": 42,
    "num_workers": 4,
    "global_batch_size": 2,
    "micro_batch_size": 2,
    "seq_len": 4096,
    "pack_batch": 1000
  },
  "checkpointing": {
    "save_steps": 100,
    "resume": null
  },
  "seed": 0,
  "run_name": "midtrain_synth30_replay70"
}
